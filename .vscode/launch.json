{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flask API: debug",
      "type": "debugpy",
      "request": "launch",
      "module": "flask",
      "env": {
        "FLASK_APP": "run.py",
        "FLASK_DEBUG": "1"
      },
      "args": [
        "run",
        "--debug"
      ],
      "jinja": true,
      "justMyCode": true
    },
    {
      "name": "Pytest: all tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-q"
      ],
      "justMyCode": true
    }
  ]
}
